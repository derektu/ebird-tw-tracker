{
  "name": "ebird-tracker",
  "version": "0.1.0",
  "description": "Taiwan eBird observation search and background tracking application",
  "author": "Derek Tu",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "node server.mjs",
    "build": "vite build",
    "start": "NODE_ENV=production node server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "check": "npm run typecheck && npm test && npm run build",
    "build:search": "vite build --config vite.search.config.ts",
    "dev:cloudflare": "XDG_CONFIG_HOME=.wrangler-config WRANGLER_WRITE_LOGS=false wrangler dev --local --port 7082",
    "test:worker": "node --test test/search-worker.test.mjs",
    "test:browser": "npm run build:search && playwright test",
    "check:all": "npm run check && npm run test:worker && npm run test:browser",
    "electron:dev": "electron .",
    "electron:pack": "npm run build && electron-builder --dir --publish never",
    "electron:build:mac": "npm run build && electron-builder --mac dmg --publish never",
    "electron:build:mac:adhoc": "npm run electron:build:mac",
    "electron:build:mac:all": "npm run build && electron-builder --mac dmg --x64 --arm64 --publish never",
    "electron:build:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "electron:dist": "npm run electron:build:mac"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "wrangler": "^4.121.0"
  },
  "build": {
    "appId": "com.derektu.ebird-tw-tracker",
    "productName": "eBird Taiwan Tracker",
    "asar": true,
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "server/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "identity": "-",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": ["dmg"]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true
    }
  }
}
